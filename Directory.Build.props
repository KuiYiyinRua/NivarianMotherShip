<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath Condition="'$(MSBuildProjectName)' == 'NivarianCommander.RimWorld17'">obj/RimWorld17/</BaseIntermediateOutputPath>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)../..</GameRoot>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == ''">$(GameRoot)/Mods/2009463077/Current/Assemblies/0Harmony.dll</HarmonyAssembly>
    <NivarianRaceAssembly Condition="'$(NivarianRaceAssembly)' == ''">$(GameRoot)/Mods/3624805128/1.6/Assemblies/Nivarian_Race.dll</NivarianRaceAssembly>
    <LumiParticleAssembly Condition="'$(LumiParticleAssembly)' == ''">$(GameRoot)/Mods/3624805128/LumiParticle1.6/Assemblies/LumiParticle.dll</LumiParticleAssembly>
    <MultiplayerApiAssembly Condition="'$(MultiplayerApiAssembly)' == ''">$(GameRoot)/Mods/Multiplayer/1.6/Assemblies/0MultiplayerAPI.dll</MultiplayerApiAssembly>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
