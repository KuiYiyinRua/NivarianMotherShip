  <ThingDef ParentName="NMC_ArchonRaimentBase"><defName>NMC_ArchonCirclet</defName><label>黑暗执政官头环</label><description>黑暗执政官的开放式灵能头环，与礼服共同构成防护装备。支援结束后随军团撤离。</description><graphicData><texPath>NMC/GhostEquipment/ghost_circlet_south</texPath><graphicClass>Graphic_Single</graphicClass></graphicData><apparel><bodyPartGroups><li>FullHead</li></bodyPartGroups><layers><li>Overhead</li></layers><wornGraphicPath>NMC/GhostEquipment/ghost_circlet</wornGraphicPath><renderSkipFlags><li>None</li></renderSkipFlags><drawData><scale>0.72</scale><defaultData><offset>(0,0,0.10)</offset></defaultData></drawData><developmentalStageFilter>Adult</developmentalStageFilter></apparel></ThingDef>
