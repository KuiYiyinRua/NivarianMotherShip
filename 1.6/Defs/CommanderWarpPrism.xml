<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_WarpPrism</defName>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <label>涅瓦莲折跃舰</label>
    <description>无武装运输与供能舰。3×3格，生命350，载重1000千克。升空后可展开半径6格能量场，为设备供电、单位充能并接收人员折跃；展开期间无法移动。同图能量场共用10000W上限。

燃料容量600，地图飞行和展开时每10秒耗1，世界航行每格耗0.75、最低12.5。可用2份电池升级动力，升级后起飞耗50，免持续耗油。

获取：先研究“跨域人员折跃”，再在上行链路研究“涅瓦莲折跃舰”并建造。</description>
    <thingClass>NivarianCommander.Building_NivarianAircraft</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>10</pathCost>
    <blockWind>false</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>0</fillPercent>
    <size>(3,3)</size>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <uiIconScale>1</uiIconScale>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>NMC/Fleet/warp_prism</texPath>
      <shaderType>Cutout</shaderType>
      <drawSize>(2.884477,3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <Flammability>0.15</Flammability>
      <WorkToBuild>42500</WorkToBuild>
      <Mass>350</Mass>
      <Comfort>0.65</Comfort>
    </statBases>
    <tickerType>Normal</tickerType>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <costList>
      <Nivarian_DragonfrostSteel>255</Nivarian_DragonfrostSteel>
      <Plasteel>150</Plasteel>
      <ComponentSpacer>5</ComponentSpacer>
      <Nivarian_DragonCrystal>85</Nivarian_DragonCrystal>
      <Gold>42</Gold>
      <Nivarian_CryoCoolant>21</Nivarian_CryoCoolant>
    </costList>
    <canOverlapZones>true</canOverlapZones>
    <rotatable>true</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <selectable>true</selectable>
    <hasCustomRectForSelector>true</hasCustomRectForSelector>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
    </building>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>NMC_WarpPrismResearch</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>NMC_WarpPrismShip</shipDef>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftLaunchable">
        <fuelPerTile>.75</fuelPerTile>
        <minFuelCost>12.5</minFuelCost>
        <skyfallerLeaving>NMC_WarpPrismLeaving</skyfallerLeaving>
        <worldObjectDef>NMC_WarpPrismFlying</worldObjectDef>
        <cooldownTicks>0</cooldownTicks>
        <fixedLaunchDistanceMax>-1</fixedLaunchDistanceMax>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftTransporter">
        <massCapacity>1000</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>600</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>600</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>Chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <uiOrder>2610</uiOrder>
    <tradeability>None</tradeability>
    <modExtensions>
      <li Class="Nivarian_Race.Code.NivarianDefModExtension.DefExtension_NivarianAutoBuilder">
        <atBuilderDef>Nivarian_SelfBuildingSiteCore</atBuilderDef>
        <designDef>Nivarian_Category</designDef>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="ShuttleSkyfallerBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_WarpPrismIncoming</defName>
    <label>涅瓦莲折跃舰（降落）</label>
    <thingClass>PassengerShuttleIncoming</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>NMC/Fleet/warp_prism</texPath>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(2.884477,3)</drawSize>
      <color>(1,1,1)</color>
    </graphicData>
    <size>(3,3)</size>
    <skyfaller>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <minimalRoofDestruction>true</minimalRoofDestruction>
      <shadowSize>(3,3)</shadowSize>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
    <rotatable>true</rotatable>
  </ThingDef>
  <ThingDef ParentName="ShuttleSkyfallerBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_WarpPrismLeaving</defName>
    <label>涅瓦莲折跃舰（起飞）</label>
    <thingClass>PassengerShuttleLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>NMC/Fleet/warp_prism</texPath>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(2.884477,3)</drawSize>
      <color>(1,1,1)</color>
    </graphicData>
    <size>(3,3)</size>
    <skyfaller>
      <reversed>true</reversed>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(3,3)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.08,2)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.2)</li>
          <li>(0.4,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>
  <TransportShipDef MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_WarpPrismShip</defName>
    <label>涅瓦莲折跃舰</label>
    <shipThing>NMC_WarpPrism</shipThing>
    <arrivingSkyfaller>NMC_WarpPrismIncoming</arrivingSkyfaller>
    <leavingSkyfaller>NMC_WarpPrismLeaving</leavingSkyfaller>
    <worldObject>NMC_WarpPrismFlying</worldObject>
    <playerShuttle>true</playerShuttle>
  </TransportShipDef>
  <WorldObjectDef ParentName="ShuttleWorldObjectBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_WarpPrismFlying</defName>
    <label>涅瓦莲折跃舰</label>
    <description>正在远程航行的涅瓦莲折跃舰，携带人员与货物前往目的地。</description>
    <expandingIconTexture>NMC/Fleet/warp_prism</expandingIconTexture>
    <expandingIconDrawSize>1</expandingIconDrawSize>
  </WorldObjectDef>
  <ResearchProjectDef ParentName="NivarianResearchProjectBase">
    <defName>NMC_WarpPrismResearch</defName>
    <label>涅瓦莲折跃舰</label>
    <description>解锁可建造的折跃舰：载重1000千克，可展开半径6格的供能区域并接收人员折跃。

前置：跨域人员折跃。在上行链路交付材料并研究。</description>
    <baseCost>5000</baseCost>
    <researchViewX>2</researchViewX>
    <researchViewY>2</researchViewY>
    <prerequisites>
      <li>NMC_FieldRecall</li>
    </prerequisites>
    <modExtensions>
      <li Class="Nivarian.ResearchCostExtension">
        <requiredMaterials>
          <li>
            <thingDef>Steel</thingDef>
            <count>500</count>
          </li>
          <li>
            <thingDef>ComponentSpacer</thingDef>
            <count>10</count>
          </li>
          <li>
            <thingDef>Nivarian_DragonCrystal</thingDef>
            <count>150</count>
          </li>
        </requiredMaterials>
      </li>
    </modExtensions>
  </ResearchProjectDef>
</Defs>
