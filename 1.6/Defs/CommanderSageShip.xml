<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_SageShip</defName>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <label>涅瓦莲贤者舰</label>
    <description>涅瓦莲贤者舰是一艘轻型反隐与对地作战舰船，占地2×2格，基础生命值350，载重200千克。

攻击模式默认关闭，开启并升空后攻击12格内的地面敌人。每0.5秒同时发射两束蓝色棱晶激光，每束6点基础伤害、30%穿甲；每次齐射消耗1化合燃料。不能攻击飞行或被引力束抬升的目标。

被动解除半径50格内敌对单位的隐身，停泊时同样有效，无需开启攻击模式。离开探测范围后，目标按原有隐身恢复规则恢复。

地图飞行和世界航行速度均比引力舰快25%。地图升空每10秒消耗1化合燃料；远航每格0.75、最低12.5，均为引力舰的一半。燃料容量600。可折跃至已解锁的折跃能量场。

星舰动力升级需要1份电池（引力舰的一半），支持米莉拉星舰电池、不稳定能量电池或虚空电池；电池按完整物品投入。升级后每次起飞消耗50化合燃料，免持续飞行耗油，攻击仍每次消耗1燃料。</description>
    <thingClass>NivarianCommander.Building_NivarianAircraft</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>10</pathCost>
    <blockWind>false</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>0</fillPercent>
    <size>(2,2)</size>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <uiIconScale>1</uiIconScale>
    <graphicData>
      <graphicClass>NivarianCommander.Graphic_GravityFrigate</graphicClass>
      <texPath>NMC/Fleet/sage_ship</texPath>
      <shaderType>Cutout</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <Flammability>0.15</Flammability>
      <WorkToBuild>25000</WorkToBuild>
      <Mass>200</Mass>
      <Comfort>0.65</Comfort>
    </statBases>
    <tickerType>Normal</tickerType>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <costList>
      <Nivarian_DragonfrostSteel>150</Nivarian_DragonfrostSteel>
      <Plasteel>88</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
      <Nivarian_DragonCrystal>50</Nivarian_DragonCrystal>
      <Gold>25</Gold>
      <Nivarian_CryoCoolant>13</Nivarian_CryoCoolant>
    </costList>
    <canOverlapZones>true</canOverlapZones>
    <rotatable>true</rotatable>
    <hasInteractionCell>false</hasInteractionCell>
    <defaultPlacingRot>North</defaultPlacingRot>
    <selectable>true</selectable>
    <hasCustomRectForSelector>true</hasCustomRectForSelector>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
    </building>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>NMC_SageShipResearch</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>NMC_SageShipShip</shipDef>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftLaunchable">
        <fuelPerTile>0.75</fuelPerTile>
        <minFuelCost>12.5</minFuelCost>
        <skyfallerLeaving>NMC_SageShipLeaving</skyfallerLeaving>
        <worldObjectDef>NMC_SageShipFlying</worldObjectDef>
        <cooldownTicks>0</cooldownTicks>
        <fixedLaunchDistanceMax>-1</fixedLaunchDistanceMax>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftTransporter">
        <massCapacity>200</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>600</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>600</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>Chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <uiOrder>2620</uiOrder>
    <tradeability>None</tradeability>
    <modExtensions>
      <li Class="Nivarian_Race.Code.NivarianDefModExtension.DefExtension_NivarianAutoBuilder">
        <atBuilderDef>Nivarian_SelfBuildingSiteCore</atBuilderDef>
        <designDef>Nivarian_Category</designDef>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="ShuttleSkyfallerBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_SageShipIncoming</defName>
    <label>涅瓦莲贤者舰（降落）</label>
    <thingClass>PassengerShuttleIncoming</thingClass>
    <graphicData>
      <graphicClass>NivarianCommander.Graphic_GravityFrigate</graphicClass>
      <texPath>NMC/Fleet/sage_ship</texPath>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(2,2)</drawSize>
      <color>(1,1,1)</color>
    </graphicData>
    <size>(2,2)</size>
    <skyfaller>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <minimalRoofDestruction>true</minimalRoofDestruction>
      <shadowSize>(2,2)</shadowSize>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
    <rotatable>true</rotatable>
  </ThingDef>
  <ThingDef ParentName="ShuttleSkyfallerBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_SageShipLeaving</defName>
    <label>涅瓦莲贤者舰（起飞）</label>
    <thingClass>PassengerShuttleLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <graphicClass>NivarianCommander.Graphic_GravityFrigate</graphicClass>
      <texPath>NMC/Fleet/sage_ship</texPath>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(2,2)</drawSize>
      <color>(1,1,1)</color>
    </graphicData>
    <size>(2,2)</size>
    <skyfaller>
      <reversed>true</reversed>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(2,2)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.08,2)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.2)</li>
          <li>(0.4,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>
  <TransportShipDef MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_SageShipShip</defName>
    <label>涅瓦莲贤者舰</label>
    <shipThing>NMC_SageShip</shipThing>
    <arrivingSkyfaller>NMC_SageShipIncoming</arrivingSkyfaller>
    <leavingSkyfaller>NMC_SageShipLeaving</leavingSkyfaller>
    <worldObject>NMC_SageShipFlying</worldObject>
    <playerShuttle>true</playerShuttle>
  </TransportShipDef>
  <WorldObjectDef ParentName="ShuttleWorldObjectBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_SageShipFlying</defName>
    <label>涅瓦莲贤者舰</label>
    <description>正在远程航行的涅瓦莲贤者舰，携带人员与货物前往目的地。</description>
    <expandingIconTexture>NMC/Fleet/sage_ship</expandingIconTexture>
    <expandingIconDrawSize>1</expandingIconDrawSize>
  </WorldObjectDef>
  <NivarianCommander.SupportDamageDef>
    <defName>NMC_SageBeamDamage</defName>
    <label>贤者舰棱晶激光</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <isRanged>true</isRanged>
    <armorCategory>Sharp</armorCategory>
    <hediff>Burn</hediff>
    <hediffSolid>Crack</hediffSolid>
    <defaultDamage>6</defaultDamage>
    <defaultArmorPenetration>0.3</defaultArmorPenetration>
    <buildingDamageFactor>1</buildingDamageFactor>
    <buildingDamageFactorPassable>1</buildingDamageFactorPassable>
    <buildingDamageFactorImpassable>1</buildingDamageFactorImpassable>
  </NivarianCommander.SupportDamageDef>
  <ResearchProjectDef ParentName="NivarianResearchProjectBase">
    <defName>NMC_SageShipResearch</defName>
    <label>涅瓦莲贤者舰</label>
    <description>通过上行链路研究终端独立解锁涅瓦莲贤者舰。前置科技与引力舰相同，无额外任务门槛；研究量与交付材料为引力舰的50%。贤者舰具有对地双束激光与半径50格的被动反隐能力，飞行更快、耗油更低。</description>
    <baseCost>3000</baseCost>
    <prerequisites>
      <li>NMC_Support05</li>
    </prerequisites>
    <researchViewX>5</researchViewX>
    <researchViewY>7</researchViewY>
    <modExtensions>
      <li Class="Nivarian.ResearchCostExtension">
        <requiredMaterials>
          <li>
            <thingDef>Steel</thingDef>
            <count>300</count>
          </li>
          <li>
            <thingDef>ComponentSpacer</thingDef>
            <count>6</count>
          </li>
          <li>
            <thingDef>Nivarian_DragonCrystal</thingDef>
            <count>90</count>
          </li>
        </requiredMaterials>
      </li>
    </modExtensions>
  </ResearchProjectDef>
</Defs>
