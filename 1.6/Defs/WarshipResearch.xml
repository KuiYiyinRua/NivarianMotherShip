  <ResearchProjectDef ParentName="NivarianResearchProjectBase">
    <defName>NMC_WarshipArmor1</defName>
    <label>涅瓦莲战舰护甲Ⅰ</label>
    <description>强化全部涅瓦莲战舰、舰载机及援军战舰的舰体。每级增加基础最大生命值的20%，本级累计增加20%。已存在舰船保持原有血量百分比。</description>
    <baseCost>2000</baseCost>
    <prerequisites>
      <li>NMC_GravityFrigateResearch</li>
    </prerequisites>
    <researchViewX>6</researchViewX>
    <researchViewY>4</researchViewY>
    <modExtensions>
      <li Class="Nivarian.ResearchCostExtension">
        <requiredMaterials>
          <li>
            <thingDef>Steel</thingDef>
            <count>300</count>
          </li>
          <li>
            <thingDef>ComponentIndustrial</thingDef>
            <count>4</count>
          </li>
          <li>
            <thingDef>Nivarian_DragonCrystal</thingDef>
            <count>40</count>
          </li>
        </requiredMaterials>
      </li>
    </modExtensions>
  </ResearchProjectDef>
