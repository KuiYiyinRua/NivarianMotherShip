<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>NMC_NutrientEnergyTower</defName>
    <label>涅瓦莲能源塔</label>
    <description>用营养液滋养共鸣晶体，持续为母舰输送P点的能源设施，同时可向殖民地电网供应700W电力。需要定期补充食物来维持运行。

殖民者会将允许的食物运入设施，转化为营养储备。可在“营养”页调整食物种类，并在选中设施时查看当前消耗和产量。设施关闭、营养耗尽或停止运行时，母舰能量也会停止产出。

建造时先部署核心，再运入所需材料，由母舰自动完成施工。这座设施只用于供能，不能培养人员或胚胎。</description>
    <thingClass>NivarianCommander.Building_NutrientEnergyTower</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>NMC/Buildings/nutrient_energy_tower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.2,2.2)</drawSize>
      <shadowData IsNull="True"/>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.65</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>NivarianBuildings</li></thingCategories>
    <inspectorTabs><li>ITab_BiosculpterNutritionStorage</li></inspectorTabs>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>120</Mass>
      <Flammability>0.2</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Nivarian_DragonCrystal>30</Nivarian_DragonCrystal>
      <Nivarian_CryoCoolant>8</Nivarian_CryoCoolant>
    </costList>
    <researchPrerequisites><li>Nivarian_MothershipSupportInterface</li></researchPrerequisites>
    <building>
      <isEdifice>true</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
      <haulToContainerDuration>120</haulToContainerDuration>
      <fixedStorageSettings>
        <filter>
          <categories><li>Foods</li></categories>
          <specialFiltersToDisallow><li>AllowPlantFood</li></specialFiltersToDisallow>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <categories><li>Foods</li></categories>
          <disallowedCategories><li>EggsFertilized</li></disallowedCategories>
          <disallowedThingDefs>
            <li>InsectJelly</li>
            <li>MealLavish</li>
            <li>MealLavish_Veg</li>
            <li>MealLavish_Meat</li>
            <li>HemogenPack</li>
            <li>Chocolate</li>
          </disallowedThingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>NivarianCommander.CompPowerPlant_NutrientTower</compClass>
        <basePowerConsumption>-700</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <modExtensions>
      <li Class="Nivarian_Race.Code.NivarianDefModExtension.DefExtension_NivarianAutoBuilder">
        <atBuilderDef>Nivarian_SelfBuildingSiteCore</atBuilderDef>
        <designDef>Nivarian_Category</designDef>
      </li>
    </modExtensions>
  </ThingDef>
  <WorkGiverDef>
    <defName>NMC_FillNutrientEnergyTower</defName>
    <label>为涅瓦莲能源塔补充营养</label>
    <giverClass>NivarianCommander.WorkGiver_FillNutrientEnergyTower</giverClass>
    <workType>Hauling</workType>
    <verb>填充</verb>
    <gerund>填充营养</gerund>
    <priorityInType>109</priorityInType>
    <requiredCapacities><li>Manipulation</li></requiredCapacities>
  </WorkGiverDef>
</Defs>
