    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>NMC_Support02</li>
    </prerequisites>
    <researchViewX>6</researchViewX>
    <researchViewY>3</researchViewY>
    <modExtensions>
      <li Class="Nivarian.ResearchCostExtension">
        <requiredMaterials>
          <li><thingDef>Steel</thingDef><count>250</count></li>
          <li><thingDef>ComponentIndustrial</thingDef><count>8</count></li>
          <li><thingDef>Nivarian_DragonCrystal</thingDef><count>30</count></li>
        </requiredMaterials>
      </li>
    </modExtensions>
  </ResearchProjectDef>
</Defs>
