<Defs>
  <!-- Fixed combat template with original equipment drafts; no craft recipe pending equipment policy. -->
  <PawnKindDef ParentName="Nivarian_PawnKindBase">
    <defName>NMC_GhostGuard</defName><label>幽灵涅瓦莲</label>
    <defaultFactionType>NivarianSurvivorTeam</defaultFactionType><isFighter>true</isFighter><combatPower>160</combatPower>
    <apparelMoney>0</apparelMoney><weaponMoney>0</weaponMoney><invNutrition>0</invNutrition>
    <!-- Original NPC guest parameters keep vanilla prisoner transition valid. -->
    <initialResistanceRange>10~26</initialResistanceRange><initialWillRange>0.5~1</initialWillRange>
    <xenotypeSet Inherit="False"><xenotypeChances><LuminNivarian MayRequire="Ludeon.RimWorld.Biotech">1</LuminNivarian></xenotypeChances></xenotypeSet>
  </PawnKindDef>
  <HediffDef>
    <defName>NMC_GhostIdentity</defName><label>暗影卫队身份</label><description>来自涅瓦莲母舰的暗影卫队成员。她会自行作战，无法被殖民地征召。隐形能力让她能够接近敌人，但仍可能被反隐手段发现。支援结束后，她将折跃撤离。</description>
    <hediffClass>NivarianCommander.Hediff_GhostIdentity</hediffClass><isBad>false</isBad><initialSeverity>1</initialSeverity>
  </HediffDef>
  <DutyDef>
    <defName>NMC_GhostAssault</defName><alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="NivarianCommander.ThinkNode_CommanderDuty"><subNodes><li Class="NivarianCommander.JobGiver_GhostAssault" /></subNodes></thinkNode>
  </DutyDef>
  <!-- BaseWeapon deliberately avoids inherited smithing recipes and material multipliers. -->
  <ThingDef Name="NMC_GhostWeaponBase" ParentName="BaseWeapon" Abstract="True">
    <techLevel>Spacer</techLevel><smeltable>true</smeltable><burnableByRecipe>true</burnableByRecipe>
    <thingCategories><li>WeaponsMelee</li></thingCategories><weaponClasses><li>Melee</li></weaponClasses>
    <tradeability>None</tradeability><generateCommonality>0</generateCommonality>
    <statBases><MaxHitPoints>150</MaxHitPoints><Mass>2</Mass><Flammability>0</Flammability><MarketValue>2000</MarketValue></statBases>
    <graphicData><texPath>NMC/GhostEquipment/phase_twinblade</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <comps><li><compClass>CompQuality</compClass></li><li Class="CompProperties_Biocodable" /><li Class="NivarianCommander.CompProperties_GhostEquipment" /></comps>
  </ThingDef>
  <ThingDef ParentName="NMC_GhostWeaponBase">
    <defName>NMC_PhaseTwinBlade</defName><label>相位双刃</label><description>暗影卫队使用的成对相位刃，擅长快速连续的近身斩击。卫队携带的武器为大师品质，并与使用者进行生物编码绑定，其他人无法使用。</description>
    <tools><li><label>相位刃</label><capacities><li>Cut</li></capacities><power>24</power><cooldownTime>1.1</cooldownTime><armorPenetration>0.35</armorPenetration></li></tools>
  </ThingDef>
  <ThingDef ParentName="NMC_GhostWeaponBase">
    <defName>NMC_VoidHeavyBlade</defName><label>虚空重刃</label><description>暗影卫队使用的重型近战兵器。挥击速度较慢，但单次斩击威力大，适合对付防护厚重的目标。卫队携带的武器为大师品质，并以生物编码绑定使用者。</description>
    <graphicData><texPath>NMC/GhostEquipment/void_heavyblade</texPath></graphicData>
    <tools><li><label>虚空刃</label><capacities><li>Cut</li></capacities><power>40</power><cooldownTime>2</cooldownTime><armorPenetration>0.65</armorPenetration></li></tools>
  </ThingDef>
  <ThingDef ParentName="NMC_GhostWeaponBase">
    <defName>NMC_ShadowLance</defName><label>暗影长枪</label><description>暗影卫队使用的长柄近战兵器，以穿刺攻击对付敌人，兼顾出手速度和穿甲能力。卫队携带的武器为大师品质，并以生物编码绑定使用者。</description>
    <graphicData><texPath>NMC/GhostEquipment/shadow_lance</texPath></graphicData>
    <tools><li><label>暗影枪尖</label><capacities><li>Stab</li></capacities><power>30</power><cooldownTime>1.5</cooldownTime><armorPenetration>0.5</armorPenetration></li></tools>
  </ThingDef>
  <!-- No quality comp on armor: approved armor values remain 110/50/60 percent. -->
  <ThingDef Name="NMC_GhostArmorBase" ParentName="ApparelNoQualityBase" Abstract="True">
    <techLevel>Spacer</techLevel><tradeability>None</tradeability><generateCommonality>0</generateCommonality>
    <thingCategories><li>Apparel</li></thingCategories>
    <statBases><MaxHitPoints>180</MaxHitPoints><Mass>3</Mass><Flammability>0</Flammability><MarketValue>2000</MarketValue>
      <ArmorRating_Sharp>1.1</ArmorRating_Sharp><ArmorRating_Blunt>0.5</ArmorRating_Blunt><ArmorRating_Heat>0.6</ArmorRating_Heat></statBases>
    <comps><li Class="NivarianCommander.CompProperties_GhostEquipment" /></comps>
  </ThingDef>
  <ThingDef ParentName="NMC_GhostArmorBase">
    <defName>NMC_GhostSuit</defName><label>涅瓦莲幽灵装甲</label><description>暗影卫队的专属装甲，在保持隐形作战能力的同时提供锐器、钝器和热能防护。

卫队成员阵亡时，仍由她携带的专属装备会一并销毁；已脱离其携带的装备不受这一效果影响。支援结束时，仍随身携带的装备随成员撤离。</description>
    <graphicData><texPath>NMC/GhostEquipment/ghost_suit_fitted2_Thin_south</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <apparel><bodyPartGroups><li>Torso</li><li>Arms</li><li>Legs</li><li>Hands</li><li>Feet</li><li>Nivarian_Tail</li></bodyPartGroups>
      <layers><li>Shell</li></layers><wornGraphicPath>NMC/GhostEquipment/ghost_suit_fitted2</wornGraphicPath><drawData><dataEast><offset>(-0.07,0,-0.025)</offset></dataEast><dataWest><offset>(0.07,0,-0.025)</offset></dataWest></drawData><developmentalStageFilter>Adult</developmentalStageFilter></apparel>
  </ThingDef>
  <ThingDef ParentName="NMC_GhostArmorBase">
    <defName>NMC_GhostHelmet</defName><label>涅瓦莲幽灵头环</label><description>与幽灵装甲配套的开放式防护头环。它保留面部视野，并为头部提供锐器、钝器和热能防护。属于暗影卫队的专属装备。</description>
    <graphicData><texPath>NMC/GhostEquipment/ghost_circlet_south</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <apparel><bodyPartGroups><li>FullHead</li></bodyPartGroups><layers><li>Overhead</li></layers>
      <wornGraphicPath>NMC/GhostEquipment/ghost_circlet</wornGraphicPath><renderSkipFlags><li>None</li></renderSkipFlags><drawData><scale>0.72</scale><defaultData><offset>(0,0,0.10)</offset></defaultData></drawData><developmentalStageFilter>Adult</developmentalStageFilter></apparel>
  </ThingDef>
  <BackstoryDef>
    <defName>NMC_FieldTrainingChildhood</defName><slot>Childhood</slot>
    <title>母舰学徒</title><titleShort>学徒</titleShort>
    <baseDesc>[PAWN_nameDef]在母舰上学习战场纪律与基础战术。</baseDesc>
    <shuffleable>false</shuffleable><spawnCategories><li>NMC_FieldTraining</li></spawnCategories>
  </BackstoryDef>
  <BackstoryDef>
    <defName>NMC_FieldTrainingAdulthood</defName><slot>Adulthood</slot>
    <title>折跃战斗员</title><titleShort>战斗员</titleShort>
    <baseDesc>[PAWN_nameDef]接受专职作战训练，响应母舰的折跃召集。</baseDesc>
    <shuffleable>false</shuffleable><spawnCategories><li>NMC_FieldTraining</li></spawnCategories>
  </BackstoryDef>
</Defs>
