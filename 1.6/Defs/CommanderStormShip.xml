<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BuildingBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_StormShip</defName>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <label>涅瓦莲暴风舰</label>
    <description>涅瓦莲的远程雷暴攻城舰。占地5×5格，基础生命值2000，载重3500千克。升空后自动攻击100格内的敌人，也可指定攻击目标。每3秒发射一枚雷暴球：直击造成20伤害、80%穿甲；命中后在落点周围3×3格内再造成25伤害、35%穿甲。两段伤害对建筑均为5倍，爆炸不随距离衰减。

飞行速度、化合燃料容量和消耗与航母相同：最多储存10000燃料，地图飞行每秒消耗1，世界航行每格3、最低50。可通过能量场折叠前往已部署的主能量场。

停泊时可用5份兼容电池升级星舰动力，正好是航母的一半。米莉拉星舰电池和不稳定能量电池各计1份，虚空电池计2份，可混用；原版电池须卸载打包。升级中可取消并退还投入的电池。升级后每次起飞消耗200化合燃料，随后地图和世界航行不再持续耗油。</description>
    <thingClass>NivarianCommander.Building_NivarianAircraft</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>10</pathCost>
    <blockWind>false</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>0</fillPercent>
    <size>(5,5)</size>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <uiIconScale>1</uiIconScale>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>NMC/Fleet/storm_ship</texPath>
      <shaderType>Cutout</shaderType>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>2000</MaxHitPoints>
      <Flammability>0.15</Flammability>
      <WorkToBuild>126000</WorkToBuild>
      <Mass>1750</Mass>
      <Comfort>0.65</Comfort>
    </statBases>
    <tickerType>Normal</tickerType>
    <constructionSkillPrerequisite>16</constructionSkillPrerequisite>
    <costList>
      <Nivarian_DragonfrostSteel>1050</Nivarian_DragonfrostSteel>
      <Plasteel>525</Plasteel>
      <ComponentSpacer>21</ComponentSpacer>
      <Nivarian_DragonCrystal>420</Nivarian_DragonCrystal>
      <Gold>280</Gold>
      <Nivarian_CryoCoolant>70</Nivarian_CryoCoolant>
    </costList>
    <canOverlapZones>true</canOverlapZones>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <defaultPlacingRot>North</defaultPlacingRot>
    <selectable>true</selectable>
    <hasCustomRectForSelector>true</hasCustomRectForSelector>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
    </building>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>NMC_StormShipResearch</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>NMC_StormShipShip</shipDef>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftLaunchable">
        <fuelPerTile>3</fuelPerTile>
        <minFuelCost>50</minFuelCost>
        <skyfallerLeaving>NMC_StormShipLeaving</skyfallerLeaving>
        <worldObjectDef>NMC_StormShipFlying</worldObjectDef>
        <cooldownTicks>0</cooldownTicks>
        <fixedLaunchDistanceMax>-1</fixedLaunchDistanceMax>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftTransporter">
        <massCapacity>3500</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>10000</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>10000</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>Chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <uiOrder>2610</uiOrder>
    <tradeability>None</tradeability>
    <modExtensions>
      <li Class="Nivarian_Race.Code.NivarianDefModExtension.DefExtension_NivarianAutoBuilder">
        <atBuilderDef>Nivarian_SelfBuildingSiteCore</atBuilderDef>
        <designDef>Nivarian_Category</designDef>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="ShuttleSkyfallerBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_StormShipIncoming</defName>
    <label>涅瓦莲暴风舰（降落）</label>
    <thingClass>PassengerShuttleIncoming</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>NMC/Fleet/storm_ship</texPath>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(5,5)</drawSize>
      <color>(1,1,1)</color>
    </graphicData>
    <size>(5,5)</size>
    <skyfaller>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <minimalRoofDestruction>true</minimalRoofDestruction>
      <shadowSize>(5,5)</shadowSize>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.1)</li>
        </points>
      </speedCurve>
    </skyfaller>
    <rotatable>true</rotatable>
  </ThingDef>
  <ThingDef ParentName="ShuttleSkyfallerBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_StormShipLeaving</defName>
    <label>涅瓦莲暴风舰（起飞）</label>
    <thingClass>PassengerShuttleLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>NMC/Fleet/storm_ship</texPath>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(5,5)</drawSize>
      <color>(1,1,1)</color>
    </graphicData>
    <size>(5,5)</size>
    <skyfaller>
      <reversed>true</reversed>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(5,5)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.08,2)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.2)</li>
          <li>(0.4,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>
  <TransportShipDef MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_StormShipShip</defName>
    <label>涅瓦莲暴风舰</label>
    <shipThing>NMC_StormShip</shipThing>
    <arrivingSkyfaller>NMC_StormShipIncoming</arrivingSkyfaller>
    <leavingSkyfaller>NMC_StormShipLeaving</leavingSkyfaller>
    <worldObject>NMC_StormShipFlying</worldObject>
    <playerShuttle>true</playerShuttle>
  </TransportShipDef>
  <WorldObjectDef ParentName="ShuttleWorldObjectBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_StormShipFlying</defName>
    <label>涅瓦莲暴风舰</label>
    <description>正在世界地图航行的涅瓦莲暴风舰，携带人员与货物前往目的地。</description>
    <expandingIconTexture>NMC/Fleet/storm_ship</expandingIconTexture>
    <expandingIconDrawSize>1</expandingIconDrawSize>
  </WorldObjectDef>
  <ResearchProjectDef ParentName="NivarianResearchProjectBase">
    <defName>NMC_StormShipResearch</defName>
    <label>涅瓦莲暴风舰</label>
    <description>通过上行链路研究终端解锁涅瓦莲暴风舰。前置科技与航母相同，不额外要求完成任务；研究量及交付材料为航母的70%。暴风舰是一艘5×5格、2000生命、3500千克载重的远程攻城舰，以100格射程的雷暴球造成直击和3×3范围爆炸。</description>
    <baseCost>10500</baseCost>
    <prerequisites>
      <li>NMC_GravityFrigateResearch</li>
      <li>NMC_Support13</li>
      <li>NMC_Support19</li>
    </prerequisites>
    <researchViewX>5</researchViewX>
    <researchViewY>6</researchViewY>
    <modExtensions>
      <li Class="Nivarian.ResearchCostExtension">
        <requiredMaterials>
          <li>
            <thingDef>Nivarian_DragonfrostSteel</thingDef>
            <count>350</count>
          </li>
          <li>
            <thingDef>ComponentSpacer</thingDef>
            <count>7</count>
          </li>
          <li>
            <thingDef>Nivarian_DragonCrystal</thingDef>
            <count>140</count>
          </li>
        </requiredMaterials>
      </li>
    </modExtensions>
  </ResearchProjectDef>
  <ThingDef ParentName="BaseBullet">
    <defName>NMC_StormOrb</defName>
    <label>雷暴球</label>
    <thingClass>NivarianCommander.Projectile_StormOrb</thingClass>
    <graphicData>
      <texPath>NMC/Projectiles/storm_orb</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.1,1.1)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>NMC_StormImpactDamage</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <armorPenetrationBase>0.8</armorPenetrationBase>
      <speed>40</speed>
      <stoppingPower>0</stoppingPower>
    </projectile>
  </ThingDef>
  <NivarianCommander.SupportDamageDef>
    <defName>NMC_StormImpactDamage</defName>
    <label>雷暴球直击</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <isRanged>true</isRanged>
    <armorCategory>Sharp</armorCategory>
    <hediff>Burn</hediff>
    <hediffSolid>Crack</hediffSolid>
    <defaultDamage>20</defaultDamage>
    <defaultArmorPenetration>0.8</defaultArmorPenetration>
    <buildingDamageFactor>5</buildingDamageFactor>
    <buildingDamageFactorPassable>1</buildingDamageFactorPassable>
    <buildingDamageFactorImpassable>1</buildingDamageFactorImpassable>
    <soundExplosion>NMC_StormOrbImpact</soundExplosion>
  </NivarianCommander.SupportDamageDef>
  <NivarianCommander.SupportDamageDef>
    <defName>NMC_StormBlastDamage</defName>
    <label>雷暴球爆炸</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <isRanged>true</isRanged>
    <armorCategory>Sharp</armorCategory>
    <hediff>Burn</hediff>
    <hediffSolid>Crack</hediffSolid>
    <defaultDamage>25</defaultDamage>
    <defaultArmorPenetration>0.35</defaultArmorPenetration>
    <buildingDamageFactor>5</buildingDamageFactor>
    <buildingDamageFactorPassable>1</buildingDamageFactorPassable>
    <buildingDamageFactorImpassable>1</buildingDamageFactorImpassable>
    <soundExplosion>NMC_StormOrbImpact</soundExplosion>
  </NivarianCommander.SupportDamageDef>
</Defs>
