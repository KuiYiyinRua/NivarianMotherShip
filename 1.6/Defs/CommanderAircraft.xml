    <constructionSkillPrerequisite>16</constructionSkillPrerequisite>
    <costList>
      <Nivarian_DragonfrostSteel>1500</Nivarian_DragonfrostSteel>
      <Plasteel>750</Plasteel>
      <ComponentSpacer>30</ComponentSpacer>
      <Nivarian_DragonCrystal>600</Nivarian_DragonCrystal>
      <Gold>400</Gold>
      <Nivarian_CryoCoolant>100</Nivarian_CryoCoolant>
    </costList>
