<Defs>
  <!-- Source-owned aura/guard hediff, not applied until the following implementation step. -->
  <HediffDef>
    <defName>NMC_ShadowInvisibility</defName><label>暗影折跃隐形</label>
    <description>使单位保持隐形，攻击和受伤不解除效果。反隐能力可使其显形。由暗影能源塔或幽灵装甲提供。</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>false</isBad><initialSeverity>1</initialSeverity>
    <comps><li Class="HediffCompProperties_Invisibility">
      <visibleToPlayer>true</visibleToPlayer><affectedByDisruptor>true</affectedByDisruptor>
      <fadeDurationTicks>60</fadeDurationTicks><recoverFromDisruptedTicks>180</recoverFromDisruptedTicks>
    </li><li Class="HediffCompProperties_DisappearsOnDeath" /></comps>
  </HediffDef>
</Defs>
