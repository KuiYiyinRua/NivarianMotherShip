  <ThingDef ParentName="BuildingBase" MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Anomaly,Ludeon.RimWorld.Odyssey">
    <defName>NMC_Carrier</defName>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <label>涅瓦莲航母</label>
    <description>重型运输与无人机支援舰。生命2500，载重10000千克，可维持6架舰载机。每架消耗10龙霜钢、制造5秒；通过“龙霜钢储备”补料。升空后攻击60格内敌人，舰载机离舰80格返回。

燃料容量10000，地图飞行每秒耗1，世界航行每格耗3、最低50。停泊时可用10份电池升级动力，升级后起飞耗200，免持续航行耗油。

获取：在上行链路完成“涅瓦莲航母”研究后建造。</description>
    <thingClass>NivarianCommander.Building_NivarianAircraft</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>10</pathCost>
    <blockWind>false</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>0</fillPercent>
    <size>(5,7)</size>
    <drawHighlight>true</drawHighlight>
    <highlightColor>(0.56, 0.62, 0.9)</highlightColor>
    <uiIconScale>1</uiIconScale>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>NMC/Fleet/carrier</texPath>
      <shaderType>Cutout</shaderType>
      <drawSize>(8,8)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>2500</MaxHitPoints>
      <Flammability>0.15</Flammability>
      <WorkToBuild>180000</WorkToBuild>
      <Mass>2500</Mass>
      <Comfort>0.65</Comfort>
    </statBases>
    <tickerType>Normal</tickerType>
    <constructionSkillPrerequisite>16</constructionSkillPrerequisite>
    <costList>
      <Nivarian_DragonfrostSteel>1500</Nivarian_DragonfrostSteel>
      <Plasteel>750</Plasteel>
      <ComponentSpacer>30</ComponentSpacer>
      <Nivarian_DragonCrystal>600</Nivarian_DragonCrystal>
      <Gold>400</Gold>
      <Nivarian_CryoCoolant>100</Nivarian_CryoCoolant>
    </costList>
    <canOverlapZones>true</canOverlapZones>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <defaultPlacingRot>North</defaultPlacingRot>
    <selectable>true</selectable>
    <hasCustomRectForSelector>true</hasCustomRectForSelector>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
    </building>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>
    <researchPrerequisites>
      <li>NMC_CarrierResearch</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Shuttle">
        <shipDef>NMC_CarrierShip</shipDef>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftLaunchable">
        <fuelPerTile>3</fuelPerTile>
        <minFuelCost>50</minFuelCost>
        <skyfallerLeaving>NMC_CarrierLeaving</skyfallerLeaving>
        <worldObjectDef>NMC_CarrierFlying</worldObjectDef>
        <cooldownTicks>0</cooldownTicks>
        <fixedLaunchDistanceMax>-1</fixedLaunchDistanceMax>
      </li>
      <li Class="NivarianCommander.CompProperties_AircraftTransporter">
        <massCapacity>10000</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>10000</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>10000</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelLabel>Chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <uiOrder>2600</uiOrder>
    <tradeability>None</tradeability>
    <modExtensions>
      <li Class="Nivarian_Race.Code.NivarianDefModExtension.DefExtension_NivarianAutoBuilder">
        <atBuilderDef>Nivarian_SelfBuildingSiteCore</atBuilderDef>
        <designDef>Nivarian_Category</designDef>
      </li>
    </modExtensions>
  </ThingDef>
